NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required. Server-side only, never exposed to the browser — keep it out of any
# NEXT_PUBLIC_ variable. Signing in asks for a username, and turning that into
# the email Supabase Auth expects means reading a row RLS hides from everyone
# but its owner, so the lookup runs with this key (see lib/supabase/admin.ts).
# `pnpm okru:sync` uses it too.
SUPABASE_SERVICE_ROLE_KEY=            # Dashboard -> Settings -> API -> service_role

# Optional. Where the links Supabase sends by email come back to — confirming a
# sign-up, confirming a new address. Derived from the request when unset, which
# is right in dev and behind most proxies; set it to pin those links to the
# canonical domain. Either way, the origin has to be listed under
# Authentication -> URL Configuration -> Redirect URLs in the dashboard.
# SITE_URL=https://novagiv.com

# --- ok.ru import (optional) ---

# Lets the importer see your friends-only/private channels, not just public
# ones. Paste the raw Cookie header from a logged-in ok.ru session in your own
# browser (DevTools -> Network -> any request to ok.ru -> Request Headers ->
# "cookie"). Treat it like a password: never commit it, never share it. It
# stops working when the session expires — grab a fresh one then.
# OKRU_COOKIE=

# Profile whose channels `pnpm okru:sync` reads. Defaults to NovaGiv's.
# OKRU_PROFILE_URL=https://ok.ru/profile/597703328549/video/channels

# `pnpm okru:sync` writes to Supabase, and RLS only allows writes from an admin
# account — the anon key above is not enough. The service-role key above covers
# it; these are the fallback if you would rather the script signed in as the
# admin instead.
# SUPABASE_ADMIN_EMAIL=
# SUPABASE_ADMIN_PASSWORD=
