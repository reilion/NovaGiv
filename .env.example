NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- ok.ru import (optional) ---

# Lets the importer see your friends-only/private channels, not just public
# ones. Paste the raw Cookie header from a logged-in ok.ru session in your own
# browser (DevTools -> Network -> any request to ok.ru -> Request Headers ->
# "cookie"). Treat it like a password: never commit it, never share it. It
# stops working when the session expires — grab a fresh one then.
# OKRU_COOKIE=

# Profile whose channels `pnpm okru:sync` reads. Defaults to NovaGiv's.
# OKRU_PROFILE_URL=https://ok.ru/profile/597703328549/video/channels

# `pnpm okru:sync` writes to Supabase, and RLS only allows writes from the
# `authenticated` role — the anon key above is not enough. Provide EITHER a
# service-role key, OR the admin account's credentials.
# SUPABASE_SERVICE_ROLE_KEY=          # Dashboard -> Settings -> API -> service_role
# SUPABASE_ADMIN_EMAIL=
# SUPABASE_ADMIN_PASSWORD=
