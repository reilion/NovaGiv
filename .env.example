NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Lets the /admin/import ok.ru scraper see your friends-only/private
# channels, not just public ones. Paste the raw Cookie header from a logged-in
# ok.ru session in your own browser (DevTools -> Network -> any request to
# ok.ru -> Request Headers -> "cookie"). Treat it like a password: never
# commit it, never share it. It will stop working when the session expires
# and you'll need to grab a fresh one.
# OKRU_COOKIE=
